# Lilysana Education — Environment Variables
# Copy this to .env and fill in your values

# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Secret used to sign internal tokens (any random string ≥ 32 chars)
SECRET_KEY=change_me_to_a_random_secret_key_32chars

# Database URL (SQLite for local dev, switch to postgresql+asyncpg:// for prod)
DATABASE_URL=sqlite+aiosqlite:///./lilysana.db

# Mini App URL (ngrok tunnel or production URL where frontend is served)
MINI_APP_URL=https://your-ngrok-url.ngrok.io

# Server host/port
HOST=0.0.0.0
PORT=8000

# Set to "true" for local dev (bypasses Telegram initData check with a mock user)
DEV_MODE=false
DEV_USER_ID=12345678

# Webhook URL (leave empty to use long-polling mode)
WEBHOOK_URL=

# Default timezone
DEFAULT_TIMEZONE=Europe/Kyiv
